---
import ProfileGlyph from './ProfileGlyph.astro';
import { getProfileDisplayNumber, profileSections } from '../data/site';
interface Props { headingLevel?: 'h1' | 'h2' }
const { headingLevel = 'h2' } = Astro.props;
const HeadingTag = headingLevel;
const ProfileHeadingTag = headingLevel === 'h1' ? 'h2' : 'h3';
const clipId = `profile-thread-${crypto.randomUUID()}`;
---
<section class="about" data-profile-surface aria-labelledby={`${clipId}-title`}>
  <div class="wrap">
    <header class="about-intro">
      <div class="section-label">About</div>
      <p class="about-code">Profile / in progress</p>
      <HeadingTag class="about-title" id={`${clipId}-title`}>关于这个人</HeadingTag>
    </header>
    <div class="profile-list">
      {profileSections.map((item, index) => (
        <article class="profile-row" data-profile-key={item.key}>
          <span class="profile-index">{getProfileDisplayNumber(index)}</span>
          <ProfileHeadingTag class="profile-title">{item.title}</ProfileHeadingTag>
          <p class="profile-prompt">{item.prompt}</p>
          <span class="profile-glyph" data-profile-glyph data-profile-node={item.key} aria-hidden="true">
            <ProfileGlyph kind={item.key} />
          </span>
        </article>
      ))}
      <svg class="profile-thread" data-profile-path aria-hidden="true" focusable="false">
        <defs><clipPath id={clipId} clipPathUnits="userSpaceOnUse"><rect data-thread-clip width="100%" height="0" /></clipPath></defs>
        <path class="thread-base" />
        <path class="thread-progress" data-thread-progress clip-path={`url(#${clipId})`} />
      </svg>
    </div>
  </div>
</section>
<style>
  .about {
    --thread-reading-line: .62;
    --thread-focus-line: .52;
    --thread-finish-range: .65;
    --thread-finish-lead: 64;
    --thread-ink: #b29369;
    --thread-muted: #d8cebf;
    position: relative;
    padding: max(96px, calc(8vh + 24px)) 0 88px;
  }
  .about-intro { display: grid; grid-template-columns: 1fr auto; align-items: end; margin-bottom: 24px; }
  .section-label { margin: 0; color: var(--text-secondary); letter-spacing: .12em; }
  .about-code { grid-column: 2; grid-row: 1 / 3; margin: 0 0 6px; max-width: 130px; font: 400 var(--text-caption)/1.8 var(--font-mono); color: var(--text-secondary); text-align: right; letter-spacing: .12em; text-transform: uppercase; }
  .about-title { grid-column: 1; grid-row: 2; font: 400 clamp(40px, 5.6vw, 80px)/1.2 var(--font-title); margin-top: 12px; letter-spacing: 0; }
  .profile-list { position: relative; }
  .profile-row { position: relative; z-index: 1; display: grid; grid-template-columns: 32px minmax(0, 1fr) minmax(0, 1fr) 56px; column-gap: 28px; row-gap: 10px; align-items: start; align-content: center; min-height: 240px; padding: 30px 0; }
  .profile-row:nth-child(even) { margin-left: 6%; }
  .profile-title { grid-column: 2; grid-row: 1; font: 400 clamp(32px, 3.4vw, 44px)/1.25 var(--font-title); letter-spacing: 0; }
  .profile-prompt { grid-column: 2; grid-row: 2; max-width: 24em; font: 400 16px/1.9 var(--font-body); color: var(--text-secondary); }
  .profile-row:nth-child(even) .profile-title, .profile-row:nth-child(even) .profile-prompt { grid-column: 3 / 5; }
  .profile-index { align-self: start; margin-top: 12px; font: 400 var(--text-caption)/1.6 var(--font-mono); color: var(--text-secondary); letter-spacing: .1em; }
  .profile-index::after { content: ''; display: block; width: 26px; height: 1px; background: #c7b394; margin-top: 14px; }
  .profile-glyph { position: relative; display: block; width: 130px; height: 130px; grid-column: 3; grid-row: 1 / 3; justify-self: center; align-self: center; color: #a08a6d; transform: rotate(-8deg); background: var(--surface-0); border: 1px solid var(--thread-muted); border-radius: 50%; padding: 16px; }
  .profile-row:nth-child(even) .profile-glyph { grid-column: 2; transform: rotate(9deg); }
  .profile-title, .profile-index, .profile-glyph { transition: color 260ms ease, transform 350ms var(--ease-out-expo), box-shadow 350ms ease; }
  .profile-row.is-reading .profile-title, .profile-row.is-reading .profile-index { color: var(--accent); }
  .profile-row.is-reading .profile-glyph { color: var(--accent); border-color: var(--thread-ink); box-shadow: 0 8px 24px #9c73451a; transform: translateY(-4px) rotate(0deg) scale(1.06); }
  .profile-thread { display: none; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .is-thread-ready .profile-thread { display: block; }
  .thread-base { fill: none; stroke: var(--thread-muted); stroke-width: 1; stroke-dasharray: 2 7; }
  .thread-progress { fill: none; stroke: var(--thread-ink); stroke-width: 1.3; opacity: .65; }
  @media (max-width: 850px) {
    .about-intro { grid-template-columns: 1fr; }
    .about-code { grid-column: 1; grid-row: 2; max-width: none; text-align: left; margin: 8px 0 0; }
    .about-title { grid-row: 3; }
    .profile-row, .profile-row:nth-child(even) { grid-template-columns: 26px minmax(0, 1fr) 70px; gap: 14px; margin-left: 0; min-height: 210px; }
    .profile-row:nth-child(even) .profile-prompt, .profile-row:nth-child(even) .profile-title { grid-column: 2; }
    .profile-glyph, .profile-row:nth-child(even) .profile-glyph { grid-column: 3; width: 68px; height: 68px; padding: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .profile-title, .profile-index, .profile-glyph { transition: none; }
    .profile-glyph, .profile-row:nth-child(even) .profile-glyph, .profile-row.is-reading .profile-glyph { transform: none; box-shadow: none; }
  }
  @media (max-width: 760px) {
    .about { padding: 96px 0 48px; }
    .about-intro { margin-bottom: 24px; }
    .profile-row,
    .profile-row:nth-child(even) {
      grid-template-columns: minmax(0, 1fr) clamp(52px, 15vw, 64px);
      column-gap: 16px; row-gap: 8px;
      min-height: 0; padding: 24px 0 28px; margin-left: 0;
    }
    .profile-index { grid-column: 1; grid-row: 1; margin: 0; line-height: 1.4; }
    .profile-index::after { display: inline-block; vertical-align: middle; width: 20px; margin: 0 0 0 10px; }
    .profile-title,
    .profile-row:nth-child(even) .profile-title {
      grid-column: 1; grid-row: 2; font-size: clamp(28px, 7.5vw, 32px); line-height: 1.3;
    }
    .profile-prompt,
    .profile-row:nth-child(even) .profile-prompt {
      grid-column: 1; grid-row: 3; max-width: none; font-size: 16px; line-height: 1.8;
    }
    .profile-glyph,
    .profile-row:nth-child(even) .profile-glyph {
      grid-column: 2; grid-row: 2 / 4; width: clamp(52px, 15vw, 64px);
      height: clamp(52px, 15vw, 64px); padding: 8px;
    }
    .profile-row:nth-child(even) {
      grid-template-columns: clamp(52px, 15vw, 64px) minmax(0, 1fr);
    }
    .profile-row:nth-child(even) .profile-index,
    .profile-row:nth-child(even) .profile-title,
    .profile-row:nth-child(even) .profile-prompt { grid-column: 2; text-align: left; }
    .profile-row:nth-child(even) .profile-glyph { grid-column: 1; }
  }
</style>
<script>
  import { mountProfileThreads } from './profile-thread';
  const lifecycle = new AbortController();
  mountProfileThreads();
  document.addEventListener('astro:page-load', mountProfileThreads, { signal: lifecycle.signal });
  addEventListener('pagehide', event => { if (!event.persisted) lifecycle.abort(); }, { signal: lifecycle.signal });
</script>
