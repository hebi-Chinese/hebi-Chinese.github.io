---
import ProfileGlyphs from './ProfileGlyphs.astro';
import { getProfileDisplayNumber, profileSections } from '../data/site';

interface Props {
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h2' } = Astro.props;
const HeadingTag = headingLevel;
const ProfileHeadingTag = headingLevel === 'h1' ? 'h2' : 'h3';
---

<style>
  .about {
    padding: clamp(5rem, 3rem + 6vw, 10rem) 0;
  }

  .about-intro {
    margin-bottom: clamp(4rem, 7vw, 7rem);
  }

  .about-code {
    margin-top: var(--space-3);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-caption);
    color: var(--text-secondary);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .about-title {
    margin-top: var(--space-6);
    font-family: 'Instrument Serif', serif;
    font-size: clamp(3.5rem, 2.15rem + 5vw, 6rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.5fr);
    align-items: stretch;
    gap: clamp(3rem, 6vw, 7rem);
  }

  .about-visual-slot {
    position: relative;
    min-height: 0;
    align-self: stretch;
    border-top: 1px solid var(--surface-3);
    border-bottom: 1px solid var(--surface-2);
    color: var(--text-muted);
  }

  .about-visual-slot::before,
  .about-visual-slot::after {
    content: '';
    position: absolute;
    width: 2rem;
    height: 2rem;
    pointer-events: none;
  }

  .about-visual-slot::before {
    top: -1px;
    left: 0;
    border-top: 1px solid var(--accent);
    border-left: 1px solid var(--accent);
  }

  .about-visual-slot::after {
    right: 0;
    bottom: -1px;
    border-right: 1px solid var(--surface-3);
    border-bottom: 1px solid var(--surface-3);
  }

  .profile-list {
    border-top: 1px solid var(--surface-3);
  }

  .profile-row {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(8rem, 0.7fr) minmax(15rem, 1.3fr);
    align-items: center;
    gap: var(--space-6);
    min-height: 7rem;
    border-bottom: 1px solid var(--surface-2);
    transition: opacity 180ms ease, transform 240ms var(--ease-out-expo);
  }

  .profile-row::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms var(--ease-out-expo);
  }

  .profile-row:hover::before {
    transform: scaleX(1);
  }

  .profile-index {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-caption);
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .profile-title {
    font-family: 'Instrument Serif', serif;
    font-size: clamp(1.65rem, 1.25rem + 1.1vw, 2.35rem);
    font-weight: 400;
    line-height: 1;
    transition: transform 240ms var(--ease-out-expo);
  }

  .profile-row:hover .profile-title {
    transform: translateX(var(--space-2));
  }

  .profile-prompt {
    font-size: var(--text-small);
    color: var(--text-secondary);
    line-height: 1.65;
    transition: color 180ms ease;
  }

  .profile-row:hover .profile-prompt {
    color: var(--text-primary);
  }

  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
    }

    .about-visual-slot {
      min-height: 13rem;
    }
  }

  @media (max-width: 360px) {
    .about-title {
      font-size: 3rem;
      letter-spacing: -0.055em;
    }
  }

  @media (max-width: 640px) {
    .profile-row {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: var(--space-3);
      padding: var(--space-6) 0;
    }

    .profile-prompt {
      grid-column: 2 / -1;
      grid-row: 2;
      max-width: 28rem;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .profile-row,
    .profile-row::before,
    .profile-title,
    .profile-prompt {
      transition: none;
    }
  }
</style>

<section class="about" data-profile-surface>
  <div class="wrap">
    <header class="about-intro">
      <div>
        <div class="section-label">About</div>
        <p class="about-code">Profile / in progress</p>
        <HeadingTag class="about-title">关于这个人</HeadingTag>
      </div>
    </header>

    <div class="about-layout">
      <div class="about-visual-slot" aria-hidden="true">
        <ProfileGlyphs sections={profileSections} />
      </div>

      <div class="profile-list">
        {profileSections.map((item, index) => (
          <article class="profile-row" data-profile-key={item.key}>
            <span class="profile-index">{getProfileDisplayNumber(index)}</span>
            <ProfileHeadingTag class="profile-title">{item.title}</ProfileHeadingTag>
            <p class="profile-prompt">{item.prompt}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-profile-surface]').forEach((root) => {
    if (root.dataset.profileSurfaceReady === 'true') return;
    root.dataset.profileSurfaceReady = 'true';

    const glyphs = root.querySelector<HTMLElement>('[data-profile-glyphs]')!;
    const rows = root.querySelectorAll<HTMLElement>('[data-profile-key]');
    const nodes = glyphs.querySelectorAll<HTMLElement>('[data-profile-node]');

    const controller = new AbortController();
    const { signal } = controller;
    const setActiveNode = (key: string | null) => {
      glyphs.classList.toggle('is-filtering', key !== null);
      nodes.forEach((node) => node.classList.toggle('is-active', node.dataset.profileNode === key));
    };

    rows.forEach((row) => {
      const key = row.dataset.profileKey!;
      // Decorative hover only: the same information is always present in the text.
      row.addEventListener('pointerenter', () => setActiveNode(key), { passive: true, signal });
      row.addEventListener('pointerleave', () => setActiveNode(null), { passive: true, signal });
    });

    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal });
  });
</script>
