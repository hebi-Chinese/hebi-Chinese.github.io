---
import { getProjectDisplayNumber, projects } from '../data/site';

interface Props {
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h2' } = Astro.props;
const HeadingTag = headingLevel;
const CardHeadingTag = headingLevel === 'h1' ? 'h2' : 'h3';
---
<style>
  .projects { padding: var(--section-sparse) 0; overflow: hidden; }
  .projects-header { margin-bottom: 2rem; }

  .wheel-stage {
    position: relative; width: 100%;
    height: clamp(340px, 36vw, 440px);
    perspective: 1000px; cursor: grab;
    user-select: none; -webkit-user-select: none;
    display: flex; align-items: center; justify-content: center; overflow: visible;
    touch-action: pan-y;
  }
  .wheel-stage:active { cursor: grabbing; }
  .wheel-group { position: relative; width: 0; height: 0; transform-style: preserve-3d; }

  .wheel-card {
    position: absolute;
    width: clamp(280px, 30vw, 380px); height: clamp(200px, 22vw, 260px);
    transform-style: preserve-3d; transition: filter 0.3s;
    left: 50%; top: 50%; transform-origin: center center;
  }
  .wheel-stage.is-moving .wheel-card { will-change: transform; }
  .wheel-card-tilt {
    width: 100%; height: 100%;
    transform-style: preserve-3d;
    transform: translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) scale(1);
    transition: transform 420ms var(--ease-out-expo);
  }
  .wheel-card-inner {
    position: relative; width: 100%; height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .wheel-card.is-flipped .wheel-card-inner { transform: rotateY(180deg); }
  .wheel-card-toggle {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 4;
    min-width: 3rem;
    min-height: 2rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(26, 22, 18, 0.14);
    border-radius: 100px;
    background: rgba(250, 248, 244, 0.9);
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: color var(--duration-fast), border-color var(--duration-fast);
  }
  .wheel-card-toggle:hover,
  .wheel-card-toggle:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .wheel-card.is-hovered .wheel-card-tilt {
    transform:
      translate3d(var(--shift-x, 0px), var(--shift-y, 0px), 16px)
      rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg))
      scale(1.018);
  }
  .wheel-stage.has-hovered-card .wheel-card:not(.is-hovered) .wheel-card-face {
    opacity: 0.52;
    filter: saturate(0.3);
  }

  .wheel-card-face {
    position: absolute; inset: 0;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    border-radius: var(--radius-lg); border: 1px solid var(--surface-2);
    padding: clamp(1.2rem, 2.5vw, 2rem);
    display: flex; flex-direction: column; overflow: hidden;
    transition:
      opacity var(--duration-normal) var(--ease-out-expo),
      filter var(--duration-normal) var(--ease-out-expo);
  }
  .wheel-card-front { background: var(--surface-1); box-shadow: 0 8px 40px rgba(0,0,0,0.06); }
  .wheel-card-front::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0; transition: opacity var(--duration-normal);
  }
  .wheel-card:hover .wheel-card-front::before { opacity: 1; }
  .wheel-card-front::after {
    content: ''; position: absolute; inset: -1px; border-radius: var(--radius-lg);
    background: linear-gradient(135deg, transparent 40%, var(--accent) 50%, transparent 60%);
    background-size: 300% 300%; z-index: -1; opacity: 0;
    transition: opacity 0.4s; animation: borderShimmer 4s ease infinite;
  }
  .wheel-card:hover .wheel-card-front::after { opacity: 1; }
  @keyframes borderShimmer { 0% { background-position: 100% 100%; } 50% { background-position: 0% 0%; } 100% { background-position: 100% 100%; } }

  .wheel-card-back { background: var(--surface-1); box-shadow: 0 8px 40px rgba(0,0,0,0.08); transform: rotateY(180deg); overflow-y: auto; }

  .wheel-card-num { font-family: 'Instrument Serif', serif; font-size: 3rem; font-weight: 400; color: var(--text-muted); line-height: 1; margin-bottom: 0.8rem; transition: color var(--duration-normal); }
  .wheel-card:hover .wheel-card-num { color: rgba(232, 168, 76, 0.15); }
  .wheel-card-title { font-family: 'Space Grotesk', sans-serif; font-size: var(--text-h2); font-weight: var(--text-h2-w); margin-bottom: var(--space-2); }
  .wheel-card-title a { color: var(--text-primary); border-bottom: 1px solid transparent; transition: border-color var(--duration-fast), color var(--duration-fast); pointer-events: auto; position: relative; z-index: 2; }
  .wheel-card-title a:hover { border-color: var(--accent); color: var(--accent); }
  .wheel-card-brief { font-size: var(--text-small); font-weight: var(--text-small-w); color: var(--text-secondary); line-height: var(--text-small-lh); flex: 1; }
  .wheel-card-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.8rem; }
  .wheel-card-tags span { font-family: 'JetBrains Mono', monospace; font-size: 0.55rem; font-weight: 400; color: var(--text-muted); padding: 0.2rem 0.55rem; background: var(--surface-3); border-radius: 100px; letter-spacing: 0.04em; }

  .wheel-card-back .back-title { font-family: 'Space Grotesk', sans-serif; font-size: 0.95rem; font-weight: 600; color: var(--accent); margin-bottom: 0.6rem; }
  .wheel-card-back .back-desc { font-size: 0.82rem; font-weight: 300; color: var(--text-secondary); line-height: 1.7; flex: 1; }
  .wheel-card-back .back-link { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; color: var(--accent); margin-top: 0.6rem; display: inline-flex; align-items: center; gap: 0.3rem; }

  .wheel-hint { text-align: center; margin-top: 1.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; font-weight: 300; color: var(--text-muted); letter-spacing: 0.08em; opacity: 0.6; }

  .wheel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .wheel-control {
    flex: 0 0 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--surface-3);
    border-radius: 50%;
    background: transparent;
    color: var(--text-secondary);
    font: 400 1rem/1 'JetBrains Mono', monospace;
    cursor: pointer;
    transition: border-color var(--duration-fast), color var(--duration-fast), transform var(--duration-fast);
  }
  .wheel-control:hover,
  .wheel-control:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }
  .wheel-status {
    width: min(13rem, 50vw);
    min-width: 0;
    text-align: center;
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
  }

  .wheel-pointer-label {
    position: absolute;
    top: 0; left: 0;
    z-index: 120;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(var(--pointer-x, 0px), var(--pointer-y, 0px), 0) scale(0.82);
    padding: 0.35rem 0.55rem;
    border: 1px solid rgba(26, 22, 18, 0.16);
    border-radius: 100px;
    background: rgba(250, 248, 244, 0.88);
    color: var(--text-primary);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    transition: opacity var(--duration-fast), transform 120ms ease-out;
  }
  .wheel-pointer-label.is-visible {
    opacity: 1;
    transform: translate3d(var(--pointer-x, 0px), var(--pointer-y, 0px), 0) scale(1);
  }

  @media (hover: none), (pointer: coarse) {
    .wheel-pointer-label { display: none; }
    .wheel-card-tilt { transform: none !important; }
    .wheel-stage.has-hovered-card .wheel-card:not(.is-hovered) .wheel-card-face {
      opacity: 1;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel-pointer-label { display: none; }
    .wheel-card-tilt { transform: none !important; transition: none; }
    .wheel-stage.has-hovered-card .wheel-card:not(.is-hovered) .wheel-card-face {
      opacity: 1;
      filter: none;
    }
    .wheel-card-inner,
    .wheel-control,
    .wheel-card-front::after {
      animation: none;
      transition: none;
    }
  }

  @media (max-width: 768px) {
    .wheel-card { width: clamp(220px, 55vw, 300px); height: clamp(160px, 40vw, 220px); }
    .wheel-stage { height: clamp(300px, 50vw, 400px); }
  }
  @media (max-width: 480px) {
    .wheel-card { width: clamp(220px, 72vw, 280px); height: clamp(240px, 68vw, 250px); }
    .wheel-stage { height: clamp(330px, 92vw, 370px); }
    .wheel-controls { gap: var(--space-3); }
  }
</style>

<section class="projects" data-projects-wheel>
  <div class="wrap">
    <div class="projects-header" data-reveal>
      <div class="section-label">Projects</div>
      <HeadingTag class="section-title">做过的、在做的、想做的</HeadingTag>
    </div>
    <div class="wheel-stage" data-wheel-stage aria-label="3D 项目轮盘">
      <div class="wheel-group">
        {projects.map((project, index) => (
          <article
            class="wheel-card"
            data-project-card
            data-project-title={project.title}
            data-active={index === 0 ? 'true' : 'false'}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index === 0 ? undefined : true}
          >
            <div class="wheel-card-tilt">
              <div class="wheel-card-inner">
                <div class="wheel-card-face wheel-card-front" data-card-front aria-hidden="false">
                  <div class="wheel-card-num">{getProjectDisplayNumber(index)}</div>
                  <CardHeadingTag class="wheel-card-title">
                    {project.href ? (
                      <a href={project.href} target="_blank" rel="noopener noreferrer">{project.title}</a>
                    ) : project.title}
                  </CardHeadingTag>
                  <p class="wheel-card-brief">{project.brief}</p>
                  <div class="wheel-card-tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
                </div>
                <div class="wheel-card-face wheel-card-back" data-card-back aria-hidden="true" inert>
                  <CardHeadingTag class="back-title">{project.detailTitle}</CardHeadingTag>
                  <p class="back-desc">{project.detail}</p>
                  {project.href && project.linkText && (
                    <a href={project.href} target="_blank" rel="noopener noreferrer" class="back-link">
                      {project.linkText}
                    </a>
                  )}
                </div>
              </div>
              <button
                class="wheel-card-toggle"
                type="button"
                data-card-toggle
                aria-expanded="false"
                aria-label={`查看 ${project.title} 详情`}
              >
                详情
              </button>
            </div>
          </article>
        ))}
      </div>
      <div class="wheel-pointer-label" data-wheel-pointer-label aria-hidden="true">查看</div>
    </div>
    <div class="wheel-controls" data-reveal>
      <button class="wheel-control" type="button" data-project-previous aria-label="上一个项目">←</button>
      <p class="wheel-status" role="status" aria-label="当前项目" aria-live="polite" data-wheel-status>
        01 / {getProjectDisplayNumber(projects.length - 1)} · {projects[0].title}
      </p>
      <button class="wheel-control" type="button" data-project-next aria-label="下一个项目">→</button>
    </div>
    <p class="wheel-hint" data-reveal>左右拖拽旋转 · 方向按钮切换 · 详情按钮翻面</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-projects-wheel]').forEach((root) => {
    if (root.dataset.projectsWheelReady === 'true') return;
    root.dataset.projectsWheelReady = 'true';

    const stage = root.querySelector<HTMLElement>('[data-wheel-stage]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-project-card]'));
    const pointerLabel = root.querySelector<HTMLElement>('[data-wheel-pointer-label]');
    const previousButton = root.querySelector<HTMLButtonElement>('[data-project-previous]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-project-next]');
    const status = root.querySelector<HTMLElement>('[data-wheel-status]');
    const count = cards.length;
    if (!stage || !previousButton || !nextButton || !status || count === 0) return;

    const angleStep = (2 * Math.PI) / count;
    const cardAngles = cards.map((_, index) => index * angleStep);
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const controller = new AbortController();
    const { signal } = controller;

    let radius = 0;
    let rotation = 0;
    let velocity = 0;
    let targetRotation: number | null = null;
    let renderFrame = 0;
    let isDragging = false;
    let isWheelVisible = true;
    let activeIndex = 0;
    let lastMoveTime = 0;
    let lastPointerX = 0;
    const friction = 0.94;
    const dragSensitivity = 0.003;

    let focusedCard: HTMLElement | null = null;
    let pointerFrame = 0;
    let pendingPointer: { clientX: number; clientY: number; target: HTMLElement } | null = null;
    const canUsePointerEffects = window.matchMedia('(hover: hover) and (pointer: fine)').matches
      && !motionQuery.matches;

    const setFaceAccessibility = (card: HTMLElement, isActive: boolean) => {
      const isFlipped = card.classList.contains('is-flipped');
      const front = card.querySelector<HTMLElement>('[data-card-front]');
      const back = card.querySelector<HTMLElement>('[data-card-back]');
      const toggle = card.querySelector<HTMLButtonElement>('[data-card-toggle]');
      if (!front || !back || !toggle) return;

      card.toggleAttribute('inert', !isActive);
      card.setAttribute('aria-hidden', String(!isActive));
      front.toggleAttribute('inert', !isActive || isFlipped);
      front.setAttribute('aria-hidden', String(!isActive || isFlipped));
      back.toggleAttribute('inert', !isActive || !isFlipped);
      back.setAttribute('aria-hidden', String(!isActive || !isFlipped));
      toggle.setAttribute('aria-expanded', String(isFlipped));
      toggle.setAttribute('aria-label', isFlipped
        ? `返回 ${card.dataset.projectTitle ?? ''} 摘要`
        : `查看 ${card.dataset.projectTitle ?? ''} 详情`);
      toggle.textContent = isFlipped ? '摘要' : '详情';
    };

    const setActiveCard = (nextIndex: number) => {
      if (activeIndex === nextIndex && cards[nextIndex].dataset.active === 'true') return;
      activeIndex = nextIndex;
      cards.forEach((card, index) => {
        const isActive = index === activeIndex;
        card.dataset.active = String(isActive);
        setFaceAccessibility(card, isActive);
      });
      status.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(count).padStart(2, '0')} · ${cards[activeIndex].dataset.projectTitle ?? ''}`;
    };

    const findFrontCardIndex = () => {
      let frontIndex = 0;
      let frontDepth = Number.NEGATIVE_INFINITY;
      cardAngles.forEach((angle, index) => {
        const depth = Math.cos(angle + rotation);
        if (depth > frontDepth) {
          frontDepth = depth;
          frontIndex = index;
        }
      });
      return frontIndex;
    };

    const renderCards = () => {
      cards.forEach((card, index) => {
        const angle = cardAngles[index] + rotation;
        const x = Math.sin(angle) * radius;
        const z = Math.cos(angle) * radius;
        const depth = (z + radius) / (2 * radius || 1);
        const scale = 0.55 + depth * 0.45;
        const opacity = 0.15 + depth * 0.85;
        const blur = depth < 0.25 ? (1 - depth / 0.25) * 3 : 0;
        card.style.transform = `translate(-50%, -50%) translate3d(${x}px, 0, ${z}px) scale(${scale})`;
        card.style.opacity = String(opacity);
        card.style.zIndex = String(Math.round(depth * 100));
        card.style.filter = blur > 0 ? `blur(${blur}px)` : 'none';
      });
      setActiveCard(findFrontCardIndex());
    };

    const scheduleRender = () => {
      if (renderFrame) return;
      renderFrame = requestAnimationFrame(updateMotion);
    };

    const updateMotion = () => {
      renderFrame = 0;
      if (!isWheelVisible) return;
      let shouldContinue = false;

      if (targetRotation !== null) {
        const distance = targetRotation - rotation;
        if (motionQuery.matches || Math.abs(distance) < 0.001) {
          rotation = targetRotation;
          targetRotation = null;
        } else {
          rotation += distance * 0.18;
          shouldContinue = true;
        }
      } else if (!isDragging && Math.abs(velocity) >= 0.00005 && !motionQuery.matches) {
        velocity *= friction;
        rotation += velocity;
        shouldContinue = Math.abs(velocity) >= 0.00005;
        if (!shouldContinue) velocity = 0;
      }

      stage.classList.toggle('is-moving', shouldContinue || isDragging);
      renderCards();
      if (shouldContinue) scheduleRender();
    };

    const selectProject = (index: number) => {
      clearPointerEffects();
      const nextIndex = (index + count) % count;
      const baseTarget = -cardAngles[nextIndex];
      const turns = Math.round((rotation - baseTarget) / (2 * Math.PI));
      targetRotation = baseTarget + turns * 2 * Math.PI;
      velocity = 0;
      stage.classList.add('is-moving');
      scheduleRender();
    };

    const resetCardTilt = (card: HTMLElement) => {
      const tilt = card.querySelector('.wheel-card-tilt') as HTMLElement | null;
      if (!tilt) return;
      tilt.style.removeProperty('--tilt-x');
      tilt.style.removeProperty('--tilt-y');
      tilt.style.removeProperty('--shift-x');
      tilt.style.removeProperty('--shift-y');
    };

    const setFocusedCard = (activeCard: HTMLElement | null, showPointerLabel = false) => {
      if (focusedCard !== activeCard) {
        if (focusedCard) resetCardTilt(focusedCard);
        focusedCard = activeCard;
        stage.classList.toggle('has-hovered-card', Boolean(activeCard));
        cards.forEach((card) => card.classList.toggle('is-hovered', card === activeCard));
      }
      pointerLabel?.classList.toggle('is-visible', Boolean(activeCard) && showPointerLabel);
    };

    const clearPointerEffects = () => {
      pendingPointer = null;
      if (pointerFrame) cancelAnimationFrame(pointerFrame);
      pointerFrame = 0;
      setFocusedCard(null);
    };

    const updateCardPointerEffects = () => {
      pointerFrame = 0;
      const pointer = pendingPointer;
      pendingPointer = null;
      if (!pointer || isDragging) return;
      const { clientX, clientY, target } = pointer;
      const card = target.closest<HTMLElement>('[data-project-card]');
      if (!card || card.dataset.active !== 'true') {
        setFocusedCard(null);
        return;
      }

      setFocusedCard(card, !target.closest('a, button'));
      const cardRect = card.getBoundingClientRect();
      const normalizedX = ((clientX - cardRect.left) / cardRect.width - 0.5) * 2;
      const normalizedY = ((clientY - cardRect.top) / cardRect.height - 0.5) * 2;
      const tilt = card.querySelector('.wheel-card-tilt') as HTMLElement | null;
      tilt?.style.setProperty('--tilt-x', `${(-normalizedY * 2.4).toFixed(2)}deg`);
      tilt?.style.setProperty('--tilt-y', `${(normalizedX * 3.2).toFixed(2)}deg`);
      tilt?.style.setProperty('--shift-x', `${(normalizedX * 3).toFixed(2)}px`);
      tilt?.style.setProperty('--shift-y', `${(normalizedY * 2).toFixed(2)}px`);

      const stageRect = stage.getBoundingClientRect();
      pointerLabel?.style.setProperty('--pointer-x', `${clientX - stageRect.left + 16}px`);
      pointerLabel?.style.setProperty('--pointer-y', `${clientY - stageRect.top + 16}px`);
    };

    const scheduleCardPointerEffects = (e: MouseEvent) => {
      pendingPointer = { clientX: e.clientX, clientY: e.clientY, target: e.target as HTMLElement };
      if (pointerFrame) return;
      pointerFrame = requestAnimationFrame(updateCardPointerEffects);
    };

    const onPointerDown = (event: PointerEvent) => {
      if (event.button !== 0 || (event.target as HTMLElement).closest('a, button')) return;
      isDragging = true;
      targetRotation = null;
      clearPointerEffects();
      lastPointerX = event.clientX;
      lastMoveTime = performance.now();
      velocity = 0;
      stage.style.cursor = 'grabbing';
      stage.setPointerCapture(event.pointerId);
    };
    const onPointerMove = (event: PointerEvent) => {
      if (!isDragging) return;
      const dx = event.clientX - lastPointerX;
      const now = performance.now();
      const dt = Math.max(now - lastMoveTime, 1);
      velocity = (dx * dragSensitivity) / (dt / 16);
      rotation += dx * dragSensitivity;
      lastPointerX = event.clientX;
      lastMoveTime = now;
      stage.classList.add('is-moving');
      scheduleRender();
    };
    const onPointerUp = (event: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      stage.style.cursor = 'grab';
      if (stage.hasPointerCapture(event.pointerId)) stage.releasePointerCapture(event.pointerId);
      if (motionQuery.matches) velocity = 0;
      scheduleRender();
    };

    stage.addEventListener('pointerdown', onPointerDown, { signal });
    stage.addEventListener('pointermove', onPointerMove, { signal });
    stage.addEventListener('pointerup', onPointerUp, { signal });
    stage.addEventListener('pointercancel', onPointerUp, { signal });
    if (canUsePointerEffects) {
      stage.addEventListener('mousemove', scheduleCardPointerEffects, { signal });
      stage.addEventListener('mouseleave', clearPointerEffects, { signal });
    }

    cards.forEach((card) => {
      const toggle = card.querySelector<HTMLButtonElement>('[data-card-toggle]');
      toggle?.addEventListener('click', () => {
        card.classList.toggle('is-flipped');
        setFaceAccessibility(card, card.dataset.active === 'true');
      }, { signal });
    });

    previousButton.addEventListener('click', () => selectProject(activeIndex - 1), { signal });
    nextButton.addEventListener('click', () => selectProject(activeIndex + 1), { signal });

    const resizeObserver = new ResizeObserver(() => {
      radius = Math.min(stage.clientWidth * 0.38, 440);
      scheduleRender();
    });
    resizeObserver.observe(stage);

    const visibilityObserver = new IntersectionObserver((entries) => {
      isWheelVisible = entries.some((entry) => entry.isIntersecting);
      if (isWheelVisible) {
        renderCards();
        return;
      }

      targetRotation = null;
      velocity = 0;
      stage.classList.remove('is-moving');
      if (renderFrame) cancelAnimationFrame(renderFrame);
      renderFrame = 0;
      clearPointerEffects();
    });
    visibilityObserver.observe(stage);

    cards.forEach((card, index) => setFaceAccessibility(card, index === 0));
    radius = Math.min(stage.clientWidth * 0.38, 440);
    renderCards();

    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      if (renderFrame) cancelAnimationFrame(renderFrame);
      if (pointerFrame) cancelAnimationFrame(pointerFrame);
    }, { once: true, signal });
  });
</script>
