---
import { getProjectDisplayNumber, projects } from '../data/site';

interface Props {
  headingLevel?: 'h1' | 'h2';
  immersive?: boolean;
}

const { headingLevel = 'h2', immersive = false } = Astro.props;
const HeadingTag = headingLevel;
const CardHeadingTag = headingLevel === 'h1' ? 'h2' : 'h3';
---
<style>
  .projects { padding: var(--section-sparse) 0; overflow: hidden; }
  .projects-header { margin-bottom: 2rem; }
  .projects-scene-note {
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.52rem;
    line-height: 1.8;
    letter-spacing: 0.13em;
    text-align: right;
  }
  .projects--immersive .projects-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-8);
  }

  .wheel-stage {
    position: relative; width: 100%;
    height: clamp(340px, 36vw, 440px);
    perspective: 1000px; cursor: grab;
    user-select: none; -webkit-user-select: none;
    display: flex; align-items: center; justify-content: center; overflow: visible;
    touch-action: pan-y;
  }
  .wheel-stage:active { cursor: grabbing; }
  .wheel-stage.is-dragging .wheel-card { cursor: grabbing; }
  .wheel-card { -webkit-touch-callout: none; }
  .wheel-group { position: relative; width: 0; height: 0; transform-style: flat; }

  .projects--immersive .wheel-stage {
    height: clamp(440px, 47vw, 590px);
    perspective: 920px;
    perspective-origin: 50% 42%;
    isolation: isolate;
  }
  .projects--immersive .wheel-stage::before,
  .projects--immersive .wheel-stage::after {
    content: '';
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  .projects--immersive .wheel-stage::before {
    right: 4%;
    bottom: -5%;
    left: 4%;
    height: 48%;
    background-image:
      linear-gradient(to right, rgba(26, 22, 18, 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(26, 22, 18, 0.055) 1px, transparent 1px),
      linear-gradient(to right, rgba(152, 84, 10, 0.08) 1px, transparent 1px);
    background-size: 54px 54px, 54px 54px, 216px 216px;
    mask-image: radial-gradient(ellipse at 50% 15%, #000 0%, rgba(0,0,0,0.84) 34%, transparent 73%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 15%, #000 0%, rgba(0,0,0,0.84) 34%, transparent 73%);
    opacity: 0.74;
    transform: rotateX(68deg) translateZ(-84px);
    transform-origin: 50% 100%;
  }
  .projects--immersive .wheel-stage::after {
    right: 16%;
    bottom: 12%;
    left: 16%;
    height: 5rem;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(26, 22, 18, 0.21), rgba(152, 84, 10, 0.08) 42%, transparent 72%);
    filter: blur(18px);
    opacity: 0.72;
    transform: translateZ(-96px) rotateX(72deg);
  }
  .projects--immersive .wheel-group {
    z-index: 1;
    transform: translateZ(-250px);
  }

  .wheel-card {
    position: absolute;
    width: clamp(280px, 30vw, 380px); height: clamp(200px, 22vw, 260px);
    transform-style: preserve-3d; transition: filter 0.3s;
    left: 50%; top: 50%; transform-origin: center center;
  }
  .projects--immersive .wheel-card {
    width: clamp(300px, 34vw, 430px);
    height: clamp(225px, 25vw, 300px);
  }
  .wheel-stage.is-moving .wheel-card { will-change: transform; }
  .wheel-card-tilt {
    width: 100%; height: 100%;
    transform-style: flat;
    transform: translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg) scale(1);
    transition: transform 420ms var(--ease-out-expo);
  }
  .wheel-card-inner {
    position: relative; width: 100%; height: 100%;
    /* Keep the clickable face in one plane so Safari hit testing matches its bounds. */
    transform-style: flat;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .wheel-card.is-hovered .wheel-card-tilt {
    transform:
      translate3d(var(--shift-x, 0px), var(--shift-y, 0px), 16px)
      rotateX(var(--tilt-x, 0deg))
      rotateY(var(--tilt-y, 0deg))
      scale(1.018);
  }
  .wheel-stage.has-hovered-card .wheel-card:not(.is-hovered) .wheel-card-face {
    opacity: 0.52;
    filter: saturate(0.3);
  }

  .wheel-card-face {
    position: absolute; inset: 0;
    backface-visibility: hidden; -webkit-backface-visibility: hidden;
    border-radius: var(--radius-lg); border: 1px solid var(--surface-2);
    padding: clamp(1.2rem, 2.5vw, 2rem);
    display: flex; flex-direction: column; overflow: hidden;
    transition:
      opacity var(--duration-normal) var(--ease-out-expo),
      filter var(--duration-normal) var(--ease-out-expo);
  }
  .projects--immersive .wheel-card-face {
    border-radius: var(--radius-md);
    transform-style: preserve-3d;
  }
  .wheel-card-front { background: var(--surface-1); box-shadow: 0 8px 40px rgba(0,0,0,0.06); }
  .projects--immersive .wheel-card-front {
    background:
      linear-gradient(145deg, rgba(255,255,255,0.98), rgba(250,248,244,0.94));
    box-shadow:
      0 1px 0 rgba(255,255,255,0.95) inset,
      0 26px 65px rgba(26,22,18,0.14),
      0 6px 18px rgba(152,84,10,0.07);
  }
  .wheel-card-front::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0; transition: opacity var(--duration-normal);
  }
  .wheel-card:hover .wheel-card-front::before { opacity: 1; }
  .wheel-card-front::after {
    content: ''; position: absolute; inset: -1px; border-radius: var(--radius-lg);
    background: linear-gradient(135deg, transparent 40%, var(--accent) 50%, transparent 60%);
    background-size: 300% 300%; z-index: -1; opacity: 0;
    transition: opacity 0.4s; animation: borderShimmer 4s ease infinite;
  }
  .wheel-card:hover .wheel-card-front::after { opacity: 1; }
  @keyframes borderShimmer { 0% { background-position: 100% 100%; } 50% { background-position: 0% 0%; } 100% { background-position: 100% 100%; } }

  .wheel-card-num { font-family: 'Instrument Serif', serif; font-size: 3rem; font-weight: 400; color: var(--text-muted); line-height: 1; margin-bottom: 0.8rem; transition: color var(--duration-normal); }
  .wheel-card:hover .wheel-card-num { color: rgba(232, 168, 76, 0.15); }
  .wheel-card-title { font-family: 'Space Grotesk', sans-serif; font-size: var(--text-h2); font-weight: var(--text-h2-w); margin-bottom: var(--space-2); }
  .wheel-card-brief { font-size: var(--text-small); font-weight: var(--text-small-w); color: var(--text-secondary); line-height: var(--text-small-lh); flex: 1; }

  .projects--immersive .wheel-card-num { transform: translateZ(28px); }
  .projects--immersive .wheel-card-title { transform: translateZ(52px); }
  .projects--immersive .wheel-card-brief { transform: translateZ(38px); }

  .wheel-hint { text-align: center; margin-top: 1.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; font-weight: 300; color: var(--text-muted); letter-spacing: 0.08em; }

  .wheel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .wheel-control {
    flex: 0 0 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--surface-3);
    border-radius: 50%;
    background: transparent;
    color: var(--text-secondary);
    font: 400 1rem/1 'JetBrains Mono', monospace;
    cursor: pointer;
    transition: border-color var(--duration-fast), color var(--duration-fast), transform var(--duration-fast);
  }
  .wheel-control:hover,
  .wheel-control:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }
  .wheel-status {
    width: min(13rem, 50vw);
    min-width: 0;
    text-align: center;
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-caption);
    letter-spacing: 0.06em;
  }

  .wheel-pointer-label {
    position: absolute;
    top: 0; left: 0;
    z-index: 120;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(var(--pointer-x, 0px), var(--pointer-y, 0px), 0) scale(0.82);
    padding: 0.35rem 0.55rem;
    border: 1px solid rgba(26, 22, 18, 0.16);
    border-radius: 100px;
    background: rgba(250, 248, 244, 0.88);
    color: var(--text-primary);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    transition: opacity var(--duration-fast), transform 120ms ease-out;
  }
  .wheel-pointer-label.is-visible {
    opacity: 1;
    transform: translate3d(var(--pointer-x, 0px), var(--pointer-y, 0px), 0) scale(1);
  }

  @media (hover: none), (pointer: coarse) {
    .wheel-pointer-label { display: none; }
    .wheel-card-tilt { transform: none !important; }
    .wheel-stage.has-hovered-card .wheel-card:not(.is-hovered) .wheel-card-face {
      opacity: 1;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wheel-pointer-label { display: none; }
    .wheel-card-tilt { transform: none !important; transition: none; }
    .wheel-stage.has-hovered-card .wheel-card:not(.is-hovered) .wheel-card-face {
      opacity: 1;
      filter: none;
    }
    .wheel-card-inner,
    .wheel-control,
    .wheel-card-front::after {
      animation: none;
      transition: none;
    }
  .projects--immersive .wheel-card-num,
  .projects--immersive .wheel-card-title,
  .projects--immersive .wheel-card-brief { transform: none; }
  }

  @media (max-width: 768px) {
    .wheel-card { width: clamp(220px, 55vw, 300px); height: clamp(160px, 40vw, 220px); }
    .wheel-stage { height: clamp(300px, 50vw, 400px); }
    .projects--immersive .wheel-card { width: clamp(250px, 64vw, 330px); height: clamp(200px, 48vw, 245px); }
    .projects--immersive .wheel-stage { height: clamp(390px, 74vw, 480px); perspective: 760px; }
    .projects--immersive .wheel-group { transform: translateZ(-110px); }
  }
  @media (max-width: 480px) {
    .wheel-card { width: clamp(220px, 72vw, 280px); height: clamp(240px, 68vw, 250px); }
    .wheel-stage { height: clamp(330px, 92vw, 370px); }
    .wheel-controls { gap: var(--space-3); }
    .projects--immersive .projects-header { grid-template-columns: 1fr; }
    .projects--immersive .projects-scene-note { text-align: left; }
    .projects--immersive .wheel-card { width: clamp(235px, 76vw, 285px); height: clamp(230px, 68vw, 255px); }
    .projects--immersive .wheel-stage { height: clamp(370px, 112vw, 430px); }
    .projects--immersive .wheel-group { transform: translateZ(-70px); }
    .projects--immersive .wheel-stage::before { right: -16%; left: -16%; }
  }

  .wheel-card { color: var(--text-primary); text-decoration: none; cursor: pointer; border-radius: var(--radius-lg); }
  .wheel-card:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .wheel-card-destination { color: var(--accent); font-size: var(--text-small); margin-top: var(--space-3); }

  /* The readable list is the default. Only a mounted runtime enables the 3D scene. */
  .projects:not([data-wheel-enhanced]) .wheel-stage {
    display: block; height: auto; perspective: none; cursor: auto; user-select: auto;
  }
  .projects:not([data-wheel-enhanced]) .wheel-group {
    width: 100%; height: auto; transform: none;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: var(--space-6);
  }
  .projects:not([data-wheel-enhanced]) .wheel-card {
    position: relative; inset: auto; width: auto; height: auto;
  }
  .projects:not([data-wheel-enhanced]) .wheel-card-face { position: relative; min-height: 18rem; }
  .projects:not([data-wheel-enhanced]) .wheel-card-tilt,
  .projects:not([data-wheel-enhanced]) .wheel-card-inner,
  .projects:not([data-wheel-enhanced]) .wheel-card-num,
  .projects:not([data-wheel-enhanced]) .wheel-card-title,
  .projects:not([data-wheel-enhanced]) .wheel-card-brief { transform: none; }
  .projects:not([data-wheel-enhanced]) .wheel-controls,
  .projects:not([data-wheel-enhanced]) .wheel-hint,
  .projects:not([data-wheel-enhanced]) .wheel-pointer-label,
  .projects:not([data-wheel-enhanced]) .projects-scene-note,
  .projects:not([data-wheel-enhanced]) .wheel-stage::before,
  .projects:not([data-wheel-enhanced]) .wheel-stage::after,
  .projects:not([data-wheel-enhanced]) .wheel-card-front::after { display: none; animation: none; }
</style>

<section
  class:list={['projects', { 'projects--immersive': immersive }]}
  data-projects-wheel
  data-scene-depth={immersive ? 'immersive' : 'standard'}
>
  <div class="wrap">
    <div class="projects-header" data-reveal>
      <div>
        <div class="section-label">Projects</div>
        <HeadingTag class="section-title">做过的、在做的、想做的</HeadingTag>
      </div>
      {immersive && (
        <p class="projects-scene-note">DEPTH INDEX / 04<br />拖动场景，沿 Z 轴查看</p>
      )}
    </div>
    <div class="wheel-stage" data-wheel-stage aria-label="3D 项目轮盘">
      <div class="wheel-group">
        {projects.map((project, index) => (
          <a
            class="wheel-card"
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${project.title}（GitHub，新标签页）`}
            draggable="false"
            data-project-card
            data-project-title={project.title}
            data-active={index === 0 ? 'true' : 'false'}
          >
            <div class="wheel-card-tilt">
              <div class="wheel-card-inner">
                <div class="wheel-card-face wheel-card-front">
                  <div class="wheel-card-num" aria-hidden="true">{getProjectDisplayNumber(index)}</div>
                  <CardHeadingTag class="wheel-card-title">{project.title}</CardHeadingTag>
                  <p class="wheel-card-brief">{project.brief}</p>
                  <span class="wheel-card-destination">{project.linkText}</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="wheel-pointer-label" data-wheel-pointer-label aria-hidden="true">轻点查看 · 按住拖动</div>
    </div>
    <div class="wheel-controls" data-reveal>
      <button class="wheel-control" type="button" data-project-previous aria-label="上一个项目">←</button>
      <p class="wheel-status" role="status" aria-label="当前项目" aria-live="polite" data-wheel-status>
        01 / {getProjectDisplayNumber(projects.length - 1)} · {projects[0].title}
      </p>
      <button class="wheel-control" type="button" data-project-next aria-label="下一个项目">→</button>
    </div>
    <p class="wheel-hint">按住卡片或空白拖动旋转 · 轻点卡片查看 GitHub</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-projects-wheel]').forEach((root) => {
    if (root.dataset.projectsWheelReady === 'true') return;
    root.dataset.projectsWheelReady = 'true';

    const stage = root.querySelector<HTMLElement>('[data-wheel-stage]');
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-project-card]'));
    const pointerLabel = root.querySelector<HTMLElement>('[data-wheel-pointer-label]');
    const previousButton = root.querySelector<HTMLButtonElement>('[data-project-previous]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-project-next]');
    const status = root.querySelector<HTMLElement>('[data-wheel-status]');
    const count = cards.length;
    const isImmersive = root.dataset.sceneDepth === 'immersive';
    if (!stage || !previousButton || !nextButton || !status || count === 0) return;

    const angleStep = (2 * Math.PI) / count;
    const cardAngles = cards.map((_, index) => index * angleStep);
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const controller = new AbortController();
    const { signal } = controller;

    let radius = 0;
    let rotation = 0;
    let desiredRotation = 0;
    let lastFrameTime = 0;
    let velocity = 0;
    let targetRotation: number | null = null;
    let renderFrame = 0;
    let isDragging = false;
    let isWheelVisible = true;
    let activeIndex = 0;
    let lastPointerX = 0;
    // Milliseconds and radians/ms keep the same coast-down on 60/120 Hz screens.
    const momentumDecay = 600;
    const followTime = 55;
    const stopSpeed = 0.00002;
    const samples: { x: number; time: number }[] = [];
    const dragSensitivity = 0.003;
    const dragThreshold = 6;
    const momentumSampleDistance = 2;
    const longPressDuration = 400;
    let gesture: { pointerId: number; startX: number; startY: number; startedAt: number; caughtMotion: boolean } | null = null;
    let suppressPointerClick = false;

    let focusedCard: HTMLElement | null = null;
    let pointerFrame = 0;
    let pendingPointer: { clientX: number; clientY: number; target: HTMLElement } | null = null;
    const canUsePointerEffects = window.matchMedia('(hover: hover) and (pointer: fine)').matches
      && !motionQuery.matches;

    const setFaceAccessibility = (card: HTMLElement, isActive: boolean) => {
      card.toggleAttribute('inert', !isActive);
      card.setAttribute('aria-hidden', String(!isActive));
    };

    const setActiveCard = (nextIndex: number) => {
      if (activeIndex === nextIndex && cards[nextIndex].dataset.active === 'true') return;
      activeIndex = nextIndex;
      cards.forEach((card, index) => {
        const isActive = index === activeIndex;
        card.dataset.active = String(isActive);
        setFaceAccessibility(card, isActive);
      });
      status.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(count).padStart(2, '0')} · ${cards[activeIndex].dataset.projectTitle ?? ''}`;
    };

    const findFrontCardIndex = () => {
      let frontIndex = 0;
      let frontDepth = Number.NEGATIVE_INFINITY;
      cardAngles.forEach((angle, index) => {
        const depth = Math.cos(angle + rotation);
        if (depth > frontDepth) {
          frontDepth = depth;
          frontIndex = index;
        }
      });
      return frontIndex;
    };

    const renderCards = () => {
      cards.forEach((card, index) => {
        const angle = cardAngles[index] + rotation;
        const wrappedAngle = Math.atan2(Math.sin(angle), Math.cos(angle));
        const x = Math.sin(angle) * radius;
        const z = Math.cos(angle) * radius;
        const depth = (z + radius) / (2 * radius || 1);
        const scale = (isImmersive ? 0.58 : 0.55) + depth * (isImmersive ? 0.42 : 0.45);
        const opacity = (isImmersive ? 0.24 : 0.15) + depth * (isImmersive ? 0.76 : 0.85);
        const blur = depth < 0.25 ? (1 - depth / 0.25) * 3 : 0;
        const y = isImmersive ? (1 - depth) * 34 : 0;
        const yaw = isImmersive ? wrappedAngle * (180 / Math.PI) * 0.68 : 0;
        card.style.transform = `translate(-50%, -50%) translate3d(${x}px, ${y}px, ${z}px) perspective(1000px) rotateY(${yaw.toFixed(2)}deg) scale(${scale})`;
        card.style.opacity = String(opacity);
        card.style.zIndex = String(Math.round(depth * 100));
        card.style.filter = blur > 0 ? `blur(${blur}px)` : 'none';
      });
      setActiveCard(findFrontCardIndex());
    };

    const scheduleRender = () => {
      if (renderFrame || !isWheelVisible || document.hidden) return;
      if (lastFrameTime === 0) lastFrameTime = performance.now();
      renderFrame = requestAnimationFrame(updateMotion);
    };

    const updateMotion = (time: number) => {
      renderFrame = 0;
      if (!isWheelVisible || document.hidden) { lastFrameTime = 0; return; }
      const elapsed = time - lastFrameTime;
      lastFrameTime = time;
      let shouldContinue = false;

      if (targetRotation !== null) {
        const distance = targetRotation - rotation;
        if (motionQuery.matches || Math.abs(distance) < 0.001) {
          rotation = targetRotation;
          targetRotation = null;
        } else {
          rotation += distance * (1 - Math.exp(-elapsed / 85));
          shouldContinue = true;
        }
        desiredRotation = rotation;
      } else {
        if (!gesture && Math.abs(velocity) >= stopSpeed && !motionQuery.matches) {
          const decay = Math.exp(-elapsed / momentumDecay);
          desiredRotation += velocity * momentumDecay * (1 - decay);
          velocity *= decay;
          if (Math.abs(velocity) < stopSpeed) velocity = 0;
        }
        const distance = desiredRotation - rotation;
        rotation = motionQuery.matches || Math.abs(distance) < 0.0001
          ? desiredRotation : rotation + distance * (1 - Math.exp(-elapsed / followTime));
        shouldContinue = velocity !== 0 || Math.abs(desiredRotation - rotation) >= 0.0001;
      }

      stage.classList.toggle('is-moving', shouldContinue || isDragging);
      renderCards();
      if (shouldContinue) scheduleRender();
      else lastFrameTime = 0;
    };

    const selectProject = (index: number) => {
      clearPointerEffects();
      const nextIndex = (index + count) % count;
      const baseTarget = -cardAngles[nextIndex];
      const turns = Math.round((rotation - baseTarget) / (2 * Math.PI));
      targetRotation = baseTarget + turns * 2 * Math.PI;
      velocity = 0;
      stage.classList.add('is-moving');
      scheduleRender();
    };

    const resetCardTilt = (card: HTMLElement) => {
      const tilt = card.querySelector('.wheel-card-tilt') as HTMLElement | null;
      if (!tilt) return;
      tilt.style.removeProperty('--tilt-x');
      tilt.style.removeProperty('--tilt-y');
      tilt.style.removeProperty('--shift-x');
      tilt.style.removeProperty('--shift-y');
    };

    const setFocusedCard = (activeCard: HTMLElement | null, showPointerLabel = false) => {
      if (focusedCard !== activeCard) {
        if (focusedCard) resetCardTilt(focusedCard);
        focusedCard = activeCard;
        stage.classList.toggle('has-hovered-card', Boolean(activeCard));
        cards.forEach((card) => card.classList.toggle('is-hovered', card === activeCard));
      }
      pointerLabel?.classList.toggle('is-visible', Boolean(activeCard) && showPointerLabel);
    };

    const clearPointerEffects = () => {
      pendingPointer = null;
      if (pointerFrame) cancelAnimationFrame(pointerFrame);
      pointerFrame = 0;
      setFocusedCard(null);
    };

    const updateCardPointerEffects = () => {
      pointerFrame = 0;
      const pointer = pendingPointer;
      pendingPointer = null;
      if (!pointer || gesture || velocity !== 0) return;
      const { clientX, clientY, target } = pointer;
      const card = target.closest<HTMLElement>('[data-project-card]');
      if (!card || card.dataset.active !== 'true') {
        setFocusedCard(null);
        return;
      }

      setFocusedCard(card, true);
      const cardRect = card.getBoundingClientRect();
      const normalizedX = ((clientX - cardRect.left) / cardRect.width - 0.5) * 2;
      const normalizedY = ((clientY - cardRect.top) / cardRect.height - 0.5) * 2;
      const tilt = card.querySelector('.wheel-card-tilt') as HTMLElement | null;
      tilt?.style.setProperty('--tilt-x', `${(-normalizedY * (isImmersive ? 4.8 : 2.4)).toFixed(2)}deg`);
      tilt?.style.setProperty('--tilt-y', `${(normalizedX * (isImmersive ? 6.4 : 3.2)).toFixed(2)}deg`);
      tilt?.style.setProperty('--shift-x', `${(normalizedX * (isImmersive ? 5 : 3)).toFixed(2)}px`);
      tilt?.style.setProperty('--shift-y', `${(normalizedY * (isImmersive ? 3.5 : 2)).toFixed(2)}px`);

      const stageRect = stage.getBoundingClientRect();
      pointerLabel?.style.setProperty('--pointer-x', `${clientX - stageRect.left + 16}px`);
      pointerLabel?.style.setProperty('--pointer-y', `${clientY - stageRect.top + 16}px`);
    };

    const scheduleCardPointerEffects = (e: MouseEvent) => {
      pendingPointer = { clientX: e.clientX, clientY: e.clientY, target: e.target as HTMLElement };
      if (pointerFrame) return;
      pointerFrame = requestAnimationFrame(updateCardPointerEffects);
    };

    const endGesture = (cancelled = false) => {
      if (!gesture) return;
      const releasedAt = performance.now();
      suppressPointerClick = cancelled || isDragging || gesture.caughtMotion
        || releasedAt - gesture.startedAt >= longPressDuration;
      velocity = 0;
      if (!cancelled && isDragging && !motionQuery.matches && samples.length >= 2) {
        const first = samples[0];
        const last = samples[samples.length - 1];
        const gap = releasedAt - last.time;
        const duration = last.time - first.time;
        if (gap < 280 && duration > 0) {
          const speed = (last.x - first.x) * dragSensitivity / duration;
          velocity = Math.max(-0.007, Math.min(0.007, speed)) * Math.exp(-gap / 240);
        }
      }
      if (Math.abs(velocity) < stopSpeed) velocity = 0;
      if (cancelled) desiredRotation = rotation;
      samples.length = 0;
      const pointerId = gesture.pointerId;
      gesture = null;
      isDragging = false;
      stage.style.removeProperty('cursor');
      stage.classList.remove('is-dragging');
      if (stage.hasPointerCapture(pointerId)) stage.releasePointerCapture(pointerId);
      scheduleRender();
    };

    const onPointerDown = (event: PointerEvent) => {
      if (event.button !== 0 || !event.isPrimary || gesture
        || (event.target as HTMLElement).closest('button')) return;
      // Preserve native link activation until movement or hold duration proves a gesture.
      suppressPointerClick = false;
      gesture = { pointerId: event.pointerId, startX: event.clientX,
        startY: event.clientY, startedAt: performance.now(),
        caughtMotion: velocity !== 0 || targetRotation !== null };
      desiredRotation = rotation;
      samples.length = 0;
      samples.push({ x: event.clientX, time: gesture.startedAt });
      targetRotation = null;
      velocity = 0;
      clearPointerEffects();
      lastPointerX = event.clientX;
    };
    const onPointerMove = (event: PointerEvent) => {
      if (!gesture || event.pointerId !== gesture.pointerId) return;
      const totalX = event.clientX - gesture.startX;
      const totalY = event.clientY - gesture.startY;
      if (!isDragging) {
        if (Math.hypot(totalX, totalY) < dragThreshold) return;
        if (event.pointerType === 'touch' && Math.abs(totalY) > Math.abs(totalX)) {
          endGesture(true);
          return;
        }
        isDragging = true;
        stage.setPointerCapture(event.pointerId);
        stage.classList.add('is-dragging');
        stage.style.cursor = 'grabbing';
      }
      const dx = event.clientX - lastPointerX;
      const now = performance.now();
      desiredRotation += dx * dragSensitivity;
      if (motionQuery.matches) rotation = desiredRotation;
      // Firefox can quantize a subpixel move to 1px. Keep that release noise from
      // replacing the last swipe sample; smaller movements still update position.
      if (Math.abs(event.clientX - samples[samples.length - 1].x) >= momentumSampleDistance) {
        samples.push({ x: event.clientX, time: now });
        // Retain one sample before the window boundary to cover its first segment.
        while (samples.length > 2 && samples[1].time < now - 100) samples.shift();
      }
      lastPointerX = event.clientX;
      stage.classList.add('is-moving');
      scheduleRender();
    };
    const onPointerUp = (event: PointerEvent) => {
      if (event.pointerId === gesture?.pointerId) endGesture(event.type === 'pointercancel');
    };

    stage.addEventListener('pointerdown', onPointerDown, { signal });
    // Window listeners finish short presses released outside the original card too.
    window.addEventListener('pointermove', onPointerMove, { signal });
    window.addEventListener('pointerup', onPointerUp, { signal });
    window.addEventListener('pointercancel', onPointerUp, { signal });
    window.addEventListener('blur', () => endGesture(true), { signal });
    stage.addEventListener('lostpointercapture', (event) => {
      // Touch transfers implicit capture from the card to the stage when drag starts.
      if (event.target === stage) endGesture(true);
    }, { signal });
    stage.addEventListener('dragstart', (event) => event.preventDefault(), { signal });
    stage.addEventListener('click', (event) => {
      // Keyboard Enter has detail=0 and must retain normal anchor behavior.
      if (suppressPointerClick && event.detail > 0) {
        event.preventDefault();
        event.stopPropagation();
      }
      suppressPointerClick = false;
    }, { capture: true, signal });
    if (canUsePointerEffects) {
      stage.addEventListener('mousemove', scheduleCardPointerEffects, { signal });
      stage.addEventListener('mouseleave', clearPointerEffects, { signal });
    }

    previousButton.addEventListener('click', () => selectProject(activeIndex - 1), { signal });
    nextButton.addEventListener('click', () => selectProject(activeIndex + 1), { signal });

    const resizeObserver = new ResizeObserver(() => {
      radius = isImmersive
        ? Math.min(stage.clientWidth * 0.43, 520)
        : Math.min(stage.clientWidth * 0.38, 440);
      scheduleRender();
    });
    resizeObserver.observe(stage);

    const stopMotion = () => {
      endGesture(true);
      targetRotation = null;
      desiredRotation = rotation;
      velocity = 0;
      lastFrameTime = 0;
      stage.classList.remove('is-moving');
      if (renderFrame) cancelAnimationFrame(renderFrame);
      renderFrame = 0;
      clearPointerEffects();
    };
    const visibilityObserver = new IntersectionObserver((entries) => {
      isWheelVisible = entries.some((entry) => entry.isIntersecting);
      if (isWheelVisible) renderCards();
      else stopMotion();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopMotion();
    }, { signal });
    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) stopMotion();
    }, { signal });
    visibilityObserver.observe(stage);

    root.dataset.wheelEnhanced = 'true';
    cards.forEach((card, index) => setFaceAccessibility(card, index === 0));
    radius = isImmersive
      ? Math.min(stage.clientWidth * 0.43, 520)
      : Math.min(stage.clientWidth * 0.38, 440);
    renderCards();

    document.addEventListener('astro:before-swap', () => {
      stopMotion();
      controller.abort();
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      if (renderFrame) cancelAnimationFrame(renderFrame);
      if (pointerFrame) cancelAnimationFrame(pointerFrame);
      delete root.dataset.wheelEnhanced;
      delete root.dataset.projectsWheelReady;
      cards.forEach(card => {
        card.removeAttribute('inert');
        card.removeAttribute('aria-hidden');
        for (const property of ['transform', 'opacity', 'z-index', 'filter']) card.style.removeProperty(property);
      });
    }, { once: true, signal });
  });
</script>
