---
import Hero from './Hero.astro';
import About from './About.astro';
const hasCover = Astro.slots.has('after-about');
---

<style>
  .hero-about-flow {
    position: relative;
    background: var(--surface-0);
    overflow-x: clip;
  }

  /* The positive X rotation brings the panel's lower half toward the viewer.
     Source: https://www.w3.org/TR/css-transforms-2/#perspective-property */
  .about-flow-stage {
    scroll-margin-top: 4.5rem;
    --about-angle: 68deg;
    --about-scale: 0.925;
    position: relative;
    z-index: 2;
    margin-top: -24vh;
    background:
      linear-gradient(to bottom, rgba(216, 208, 196, 0.64), rgba(236, 231, 221, 0.18) 10rem, transparent 28rem);
    /* Keep the entire tall About sheet in front of the camera at its initial tilt. */
    perspective: max(1250px, calc(var(--about-height, 0px) * 1.15));
    perspective-origin: 50% 0;
    pointer-events: auto;
  }

  .about-flow-panel {
    position: relative;
    isolation: isolate;
    width: 100%;
    background:
      linear-gradient(to bottom, #f3eee6 0, var(--surface-0) min(38rem, 55vh));
    border-top: 1px solid rgba(152, 84, 10, 0.34);
    box-shadow:
      0 -1px 0 rgba(250, 248, 244, 0.9),
      0 -20px 55px rgba(26, 22, 18, 0.115),
      0 -52px 120px rgba(26, 22, 18, 0.045);
    transform: none;
    transform-origin: 50% 0;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  .about-flow-panel::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    right: clamp(1.5rem, 4vw, 3rem);
    left: clamp(1.5rem, 4vw, 3rem);
    height: min(42rem, 62vh);
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(26, 22, 18, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(26, 22, 18, 0.04) 1px, transparent 1px),
      linear-gradient(to right, rgba(152, 84, 10, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(152, 84, 10, 0.05) 1px, transparent 1px);
    background-size: 72px 72px, 72px 72px, 288px 288px, 288px 288px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.22) 52%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.22) 52%, transparent 100%);
  }

  .about-flow-edge {
    position: absolute;
    z-index: 3;
    top: -1px;
    right: 0;
    left: 0;
    height: 0.75rem;
    background:
      linear-gradient(to bottom, rgba(250, 248, 244, 0.98), rgba(186, 174, 159, 0.78));
    border-top: 1px solid rgba(152, 84, 10, 0.28);
    transform: rotateX(-90deg);
    transform-origin: 50% 0;
    pointer-events: none;
  }

  .about-flow-panel > :global(.about) {
    position: relative;
    z-index: 1;
  }

  .about-flow-stage.is-transforming .about-flow-panel {
    will-change: transform;
  }

  :global(.about-flow-panel [data-reveal]) {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .motion-ready .about-flow-stage { pointer-events: none; }
  /* Land beyond the tilt's end (stage.top <= -8vh), before the cover begins. */
  .motion-ready .about-flow-stage { scroll-margin-top: calc(-8vh - 2px); }
  .motion-ready .about-flow-panel {
    transform: translateZ(0) rotateX(var(--about-angle)) scale(var(--about-scale));
  }
  .hero-about-flow:not(.motion-ready) .about-flow-stage { margin-top: 0; perspective: none; }
  .hero-about-flow:not(.motion-ready) .about-flow-edge { display: none; }
  .motion-ready .about-flow-stage.is-readable {
    pointer-events: auto;
  }

  .about-flow-hold { perspective: inherit; perspective-origin: 50% 0; }
  .hero-about-flow { --cover-travel: 88svh; }
  .cover-ready .about-flow-stage { height: calc(var(--about-height) + var(--cover-travel)); }
  .cover-ready .about-flow-hold { position: sticky; top: var(--about-rest-top, 0px); }
  .cover-ready .cover-sheet { position: relative; z-index: 4; margin-top: calc(-1 * var(--cover-travel)); }
  .cover-sheet > :global(.product-showcase) { margin-top: 0; }

  @media (max-width: 768px) {
    .about-flow-stage {
      --about-angle: 52deg;
      --about-scale: 0.96;
      margin-top: -14vh;
      perspective: max(980px, calc(var(--about-height, 0px) * 1.15));
    }

    .about-flow-panel::before {
      right: 1.25rem;
      left: 1.25rem;
      background-size: 48px 48px, 48px 48px, 192px 192px, 192px 192px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-ready .about-flow-stage { height: auto; }
    .cover-ready .about-flow-hold { position: relative; top: 0; }
    .cover-ready .cover-sheet { margin-top: 0; }
    .about-flow-stage, .motion-ready .about-flow-stage {
      scroll-margin-top: 4.5rem;
      margin-top: 0;
      perspective: none;
      pointer-events: auto;
    }

    .about-flow-panel, .motion-ready .about-flow-panel {
      box-shadow: none;
      transform: none;
    }

    .about-flow-edge {
      display: none;
    }
  }
</style>

<div class="hero-about-flow" data-hero-about-flow data-profile-scroll-context data-about-cover={hasCover || undefined}>
  <Hero />
  <div class="about-flow-stage" data-about-flow-stage data-profile-flow-origin id="about" data-home-section>
    <div class="about-flow-hold" data-profile-flow-hold>
      <div class="about-flow-panel">
        <div class="about-flow-edge" aria-hidden="true"></div>
        <About />
      </div>
    </div>
  </div>
  {hasCover && <div class="cover-sheet" data-profile-next-sheet><slot name="after-about" /></div>}
</div>

<script>
  import { mountAboutCovers } from './hero-about-cover';
  import { mountAboutMotion } from './hero-about-motion';
  const lifecycle = new AbortController();
  const mount = () => { mountAboutCovers(); mountAboutMotion(); };
  mount();
  document.addEventListener('astro:page-load', mount, { signal: lifecycle.signal });
  addEventListener('pagehide', event => {
    if (!event.persisted) lifecycle.abort();
  }, { signal: lifecycle.signal });
</script>
