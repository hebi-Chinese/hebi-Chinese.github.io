---
import HeroBlueprint from './HeroBlueprint.astro';
import { siteProfile } from '../data/site';
---
<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding-top: 3.25rem;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: 15%; left: -10%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(196, 113, 11, 0.06) 0%, transparent 70%);
    pointer-events: none;
    filter: blur(80px);
  }
  .hero-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-eyebrow);
    font-weight: var(--text-eyebrow-w);
    color: var(--text-muted);
    letter-spacing: var(--text-eyebrow-ls);
    text-transform: uppercase;
    margin-bottom: var(--space-8);
  }
  .hero-name {
    font-family: 'Instrument Serif', serif;
    font-size: var(--text-display);
    font-weight: var(--text-display-w);
    line-height: var(--text-display-lh);
    margin-bottom: var(--space-8);
    letter-spacing: var(--text-display-ls);
  }
  .hero-name .char {
    display: inline-block;
    transition: color 0.6s var(--ease-out-expo), transform 0.1s ease-out;
  }
  .hero-name .char:hover { color: var(--accent); }
  .hero-name .char.repulse-return {
    transition: transform 0.8s cubic-bezier(0.25, 1.5, 0.5, 1), color 0.6s var(--ease-out-expo);
  }
  .hero-sub {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }
  .hero-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--text-caption);
    font-weight: var(--text-caption-w);
    color: var(--text-secondary);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--surface-3);
    border-radius: 100px;
    letter-spacing: var(--text-caption-ls);
    transition: border-color var(--duration-fast), color var(--duration-fast);
  }
  .hero-tag:hover { border-color: var(--accent); color: var(--accent); }
  .hero-cta {
    margin-top: 3rem;
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    padding: 0.65rem 1.5rem;
    border-radius: 100px;
    cursor: pointer;
    transition:
      background var(--duration-normal) var(--ease-out-expo),
      border-color var(--duration-normal) var(--ease-out-expo),
      box-shadow var(--duration-normal) var(--ease-out-expo),
      color var(--duration-normal) var(--ease-out-expo),
      transform var(--duration-normal) var(--ease-out-expo);
    border: none;
  }
  .btn-primary { background: var(--accent); color: var(--surface-0); }
  .btn-primary:hover {
    box-shadow: 0 0 30px var(--accent-glow), 0 4px 16px rgba(0,0,0,0.08);
    transform: translateY(-2px);
  }
  .btn-ghost { background: transparent; color: var(--text-muted); border: 1px solid var(--surface-3); }
  .btn-ghost:hover { border-color: var(--text-secondary); color: var(--text-secondary); }

  .ripple-canvas { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero > .wrap { position: relative; z-index: 2; }

  @media (min-width: 1200px) and (min-height: 1000px) {
    .hero > .wrap { transform: translateY(-5vh); }
  }

  @media (max-width: 768px) {
    .hero { min-height: 85vh; }
    .hero-eyebrow { font-size: 0.5rem; }
    .hero-tag { font-size: 0.6rem; padding: 0.25rem 0.7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ripple-canvas { display: none; }
    .hero-name .char { transition: color var(--duration-fast); }
  }
</style>

<section class="hero" data-hero>
  <canvas class="ripple-canvas" data-ripple-canvas aria-hidden="true"></canvas>
  <HeroBlueprint />
  <div class="wrap">
    <p class="hero-eyebrow" data-reveal>何必 / hebi</p>
    <h1 class="hero-name" data-reveal>
      <span class="char">何</span><span class="char">必</span>
    </h1>
    <div class="hero-sub" data-reveal>
      <span class="hero-tag">主线：学习</span>
      <span class="hero-tag">副本：???</span>
      <span class="hero-tag">buff：晚10点的播客</span>
    </div>
    <div class="hero-cta" data-reveal>
      <a href="/projects" class="btn btn-primary">看看做了什么</a>
      <a href={`mailto:${siteProfile.email}`} class="btn btn-ghost">打个招呼</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((root) => {
    if (root.dataset.heroReady === 'true') return;
    root.dataset.heroReady = 'true';

    const canvas = root.querySelector<HTMLCanvasElement>('[data-ripple-canvas]');
    const nameCharacters = Array.from(root.querySelectorAll<HTMLElement>('.hero-name .char'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canUsePointerEffects = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (!canvas || reducedMotion || !canUsePointerEffects) return;

    const context = canvas.getContext('2d');
    if (!context) return;

    const controller = new AbortController();
    const { signal } = controller;
    const ripples: Ripple[] = [];
    const repulseRadius = 150;
    const repulseStrength = 60;
    let width = 0;
    let height = 0;
    let rippleFrame = 0;
    let repulseFrame = 0;
    let lastRippleTime = 0;
    let isVisible = true;
    let pointer = { x: 0, y: 0 };

    class Ripple {
      radius = 0;
      life = 1;

      constructor(
        readonly x: number,
        readonly y: number,
        readonly maxRadius = 250 + Math.random() * 150,
        readonly speed = 1.2 + Math.random() * 0.8,
        readonly lineWidth = 1.5,
      ) {}

      update() {
        this.radius += this.speed;
        this.life = 1 - this.radius / this.maxRadius;
        return this.life > 0;
      }

      draw(drawingContext: CanvasRenderingContext2D) {
        if (this.life <= 0) return;
        drawingContext.beginPath();
        drawingContext.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        drawingContext.strokeStyle = `rgba(196, 113, 11, ${this.life * 0.12})`;
        drawingContext.lineWidth = this.lineWidth * this.life;
        drawingContext.stroke();

        if (this.radius <= 20) return;
        drawingContext.beginPath();
        drawingContext.arc(this.x, this.y, this.radius * 0.65, 0, Math.PI * 2);
        drawingContext.strokeStyle = `rgba(196, 113, 11, ${this.life * 0.06})`;
        drawingContext.lineWidth = this.lineWidth * this.life * 0.5;
        drawingContext.stroke();
      }
    }

    const resizeCanvas = () => {
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
      width = root.clientWidth;
      height = root.clientHeight;
      canvas.width = Math.round(width * pixelRatio);
      canvas.height = Math.round(height * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    };

    const resetCharacters = () => {
      if (repulseFrame) cancelAnimationFrame(repulseFrame);
      repulseFrame = 0;
      nameCharacters.forEach((character) => {
        character.classList.add('repulse-return');
        character.style.transform = 'translate(0px, 0px)';
      });
    };

    const updateRepulsion = () => {
      repulseFrame = 0;
      nameCharacters.forEach((character) => {
        const rect = character.getBoundingClientRect();
        const deltaX = pointer.x - (rect.left + rect.width / 2);
        const deltaY = pointer.y - (rect.top + rect.height / 2);
        const distance = Math.hypot(deltaX, deltaY);

        if (distance >= repulseRadius || distance === 0) {
          character.classList.add('repulse-return');
          character.style.transform = 'translate(0px, 0px)';
          return;
        }

        const force = (1 - distance / repulseRadius) * repulseStrength;
        const angle = Math.atan2(deltaY, deltaX);
        character.classList.remove('repulse-return');
        character.style.transform = `translate(${-Math.cos(angle) * force}px, ${-Math.sin(angle) * force}px)`;
      });
    };

    const animateRipples = () => {
      rippleFrame = 0;
      context.clearRect(0, 0, width, height);
      for (let index = ripples.length - 1; index >= 0; index -= 1) {
        const ripple = ripples[index];
        if (!ripple.update()) ripples.splice(index, 1);
        else ripple.draw(context);
      }
      if (ripples.length > 0 && !document.hidden) {
        rippleFrame = requestAnimationFrame(animateRipples);
      }
    };

    const startRippleAnimation = () => {
      if (!rippleFrame && isVisible && !document.hidden) rippleFrame = requestAnimationFrame(animateRipples);
    };

    const stopRippleAnimation = () => {
      ripples.length = 0;
      context.clearRect(0, 0, width, height);
      if (rippleFrame) cancelAnimationFrame(rippleFrame);
      rippleFrame = 0;
    };

    root.addEventListener('pointermove', (event) => {
      pointer = { x: event.clientX, y: event.clientY };
      if (!repulseFrame) repulseFrame = requestAnimationFrame(updateRepulsion);

      const now = performance.now();
      if (now - lastRippleTime < 100) return;
      const rect = canvas.getBoundingClientRect();
      ripples.push(new Ripple(event.clientX - rect.left, event.clientY - rect.top));
      lastRippleTime = now;
      startRippleAnimation();
    }, { passive: true, signal });

    root.addEventListener('pointerleave', resetCharacters, { signal });
    root.addEventListener('click', (event) => {
      const rect = canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      for (let index = 0; index < 3; index += 1) {
        ripples.push(new Ripple(x, y, 350 + index * 120, 1.8 + index * 0.4, 2.5 - index * 0.5));
      }
      startRippleAnimation();
    }, { signal });

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) return;
      stopRippleAnimation();
      if (repulseFrame) cancelAnimationFrame(repulseFrame);
      repulseFrame = 0;
      resetCharacters();
    }, { signal });

    const visibilityObserver = new IntersectionObserver((entries) => {
      isVisible = entries.some((entry) => entry.isIntersecting);
      if (!isVisible) {
        stopRippleAnimation();
        resetCharacters();
      }
    });
    visibilityObserver.observe(root);

    const resizeObserver = new ResizeObserver(resizeCanvas);
    resizeObserver.observe(root);
    resizeCanvas();

    document.addEventListener('astro:before-swap', () => {
      controller.abort();
      resizeObserver.disconnect();
      visibilityObserver.disconnect();
      if (rippleFrame) cancelAnimationFrame(rippleFrame);
      if (repulseFrame) cancelAnimationFrame(repulseFrame);
    }, { once: true, signal });
  });
</script>
