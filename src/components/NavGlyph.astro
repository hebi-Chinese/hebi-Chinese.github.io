---
interface Props {
  kind: string;
}

const { kind } = Astro.props;
---

<svg class="nav-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {kind === 'about' && (
    <>
      <circle cx="12" cy="12" r="3.25" />
      <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1" />
      <circle class="nav-glyph__dot" cx="12" cy="12" r="1" />
    </>
  )}

  {kind === 'projects' && (
    <>
      <rect x="3" y="3" width="7" height="7" rx="1.2" />
      <rect x="14" y="3" width="7" height="7" rx="1.2" />
      <rect x="3" y="14" width="7" height="7" rx="1.2" />
      <path d="M14 14h7v7h-7z" />
      <circle class="nav-glyph__dot" cx="17.5" cy="17.5" r="1" />
    </>
  )}

  {kind === 'essays' && (
    <>
      <path d="M5 2.5h9l5 5v14H5zM14 2.5v5h5M8 11h8M8 14.5h8M8 18h5" />
    </>
  )}

  {kind === 'notes' && (
    <>
      <path d="M4 4h13v16H4zM7 8h7M7 11.5h6M7 15h4" />
      <path class="nav-glyph__accent" d="m14.5 16.5 5-5 2 2-5 5-3 .9z" />
    </>
  )}

  {kind === 'likes' && (
    <>
      <path d="M12 20S3.5 15.4 3.5 9c0-3.2 2.3-5.2 5.1-5.2 1.7 0 2.8.9 3.4 2 .6-1.1 1.7-2 3.4-2 2.8 0 5.1 2 5.1 5.2 0 6.4-8.5 11-8.5 11Z" />
      <path class="nav-glyph__accent" d="M6.5 16.2c3.4 1.8 7.6 1.8 11 0" />
    </>
  )}

  {kind === 'github' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="8" cy="8" r="1.7" />
      <circle cx="16" cy="16" r="1.7" />
      <path d="M9.7 8h2.8a3.5 3.5 0 0 1 3.5 3.5V14M8 9.7V16M8 13h3.2" />
    </>
  )}
</svg>

<style>
  .nav-glyph {
    display: block;
    width: 1.05rem;
    height: 1.05rem;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nav-glyph__accent { stroke: var(--accent); }
  .nav-glyph__dot { fill: var(--accent); stroke: none; }
</style>
