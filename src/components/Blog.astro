---
import { getCollection } from 'astro:content';
import { formatContentDate, toContentDate } from '../utils/content-date';

const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<style>
  .blog { padding: var(--section-sparse) 0; }
  .blog-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .blog-empty {
    padding: 3rem 0;
    text-align: center;
  }
  .blog-empty p {
    font-family: var(--font-annotation);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--text-muted);
    line-height: 2;
    letter-spacing: 0.02em;
  }

  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--surface-3);
  }
  .blog-item {
    border-bottom: 1px solid var(--surface-2);
  }
  .blog-item a {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(2rem, 4vw, 3.5rem) 0;
    text-decoration: none;
    color: inherit;
  }
  .blog-index {
    padding-top: 0.4rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    letter-spacing: 0.16em;
  }

  .blog-item h3 {
    font-family: var(--font-title);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 3.25rem);
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 var(--space-4);
    color: var(--text-primary, var(--text-secondary));
    text-wrap: balance;
    transition: color var(--duration-fast);
  }
  .blog-item p {
    max-width: 42rem;
    font-size: var(--text-small);
    color: var(--text-muted);
    line-height: var(--text-small-lh);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-meta {
    display: grid;
    justify-items: end;
    gap: var(--space-8);
    min-width: 7rem;
  }
  .blog-item time {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    white-space: nowrap;
  }
  .blog-arrow {
    color: var(--accent);
    font-family: var(--font-body);
    font-size: clamp(2rem, 1.5rem + 1vw, 3rem);
    line-height: 1;
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }
  .blog-item a:hover h3,
  .blog-item a:focus-visible h3 { color: var(--accent); }
  .blog-item a:hover .blog-arrow,
  .blog-item a:focus-visible .blog-arrow { transform: translate(0.35rem, -0.35rem); }

  .blog-more {
    text-align: right;
  }
  .blog-more a {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-decoration: none;
    border-bottom: 1px solid var(--text-muted);
    padding-bottom: 2px;
    transition: color var(--duration-fast, 150ms);
  }
  .blog-more a:hover { color: var(--text-primary, var(--text-secondary)); }

  @media (max-width: 700px) {
    .blog-header { grid-template-columns: 1fr; }
    .blog-more { text-align: left; }
    .blog-item a {
      grid-template-columns: 1fr auto;
      gap: var(--space-4);
      padding: var(--space-8) 0;
    }
    .blog-index { grid-column: 1; }
    .blog-copy { grid-column: 1 / -1; }
    .blog-meta {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
      gap: var(--space-3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-arrow { transition: none; }
    .blog-item a:hover .blog-arrow,
    .blog-item a:focus-visible .blog-arrow { transform: none; }
  }
</style>

<section class="blog">
  <div class="wrap">
    <div class="blog-header" data-reveal>
      <div>
        <div class="section-label">Blog</div>
        <h2 class="section-title">最近写下来的</h2>
      </div>
      {essays.length > 0 && (
        <div class="blog-more">
          <a href="/essays/">查看全部文章 →</a>
        </div>
      )}
    </div>

    {essays.length === 0 ? (
      <div class="blog-empty" data-reveal>
        <p>种子还在土里。<br/>等它长出来。</p>
      </div>
    ) : (
      <>
        <ul class="blog-list" data-reveal>
          {essays.map((essay, index) => (
            <li class="blog-item">
              <a href={`/essays/${essay.id}/`}>
                <span class="blog-index">READ / {String(index + 1).padStart(2, '0')}</span>
                <div class="blog-copy">
                  <h3>{essay.data.title}</h3>
                  {essay.data.description && <p>{essay.data.description}</p>}
                </div>
                <div class="blog-meta">
                  <time datetime={toContentDate(essay.data.date)}>{formatContentDate(essay.data.date)}</time>
                  <span class="blog-arrow" aria-hidden="true">↗</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>
