---
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---
<style>
  .blog { padding: var(--section-normal) 0; }
  .blog-header { margin-bottom: 3.5rem; }

  .blog-empty {
    padding: 3rem 0;
    text-align: center;
  }
  .blog-empty p {
    font-family: 'Instrument Serif', serif;
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--text-muted);
    line-height: 2;
    letter-spacing: 0.02em;
  }

  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle, rgba(0,0,0,0.08));
  }
  .blog-item {
    border-bottom: 1px solid var(--border-subtle, rgba(0,0,0,0.08));
  }
  .blog-item a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: baseline;
    padding: 1.6rem 0;
    text-decoration: none;
    color: inherit;
    transition: transform var(--duration-normal, 300ms) var(--ease-out-expo, cubic-bezier(0.16,1,0.3,1));
  }
  .blog-item a:hover,
  .blog-item a:focus-visible { transform: translateX(0.6rem); }

  .blog-item h3 {
    font-family: 'Instrument Serif', serif;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.35;
    margin: 0 0 0.4rem;
    color: var(--text-primary, var(--text-secondary));
  }
  .blog-item p {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-item time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .blog-more {
    margin-top: 2.5rem;
    text-align: right;
  }
  .blog-more a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-decoration: none;
    border-bottom: 1px solid var(--text-muted);
    padding-bottom: 2px;
    transition: color var(--duration-fast, 150ms);
  }
  .blog-more a:hover { color: var(--text-primary, var(--text-secondary)); }

  @media (max-width: 600px) {
    .blog-item a {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 1.4rem 0;
    }
    .blog-item time { order: -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-item a { transition: none; }
    .blog-item a:hover,
    .blog-item a:focus-visible { transform: none; }
  }
</style>

<section class="blog">
  <div class="wrap">
    <div class="blog-header" data-reveal>
      <div class="section-label">Blog</div>
      <h2 class="section-title">写下来的东西</h2>
    </div>

    {essays.length === 0 ? (
      <div class="blog-empty" data-reveal>
        <p>种子还在土里。<br/>等它长出来。</p>
      </div>
    ) : (
      <>
        <ul class="blog-list" data-reveal>
          {essays.map(essay => (
            <li class="blog-item">
              <a href={`/essays/${essay.id}/`}>
                <div>
                  <h3>{essay.data.title}</h3>
                  {essay.data.description && <p>{essay.data.description}</p>}
                </div>
                <time datetime={essay.data.date.toISOString()}>{fmtDate(essay.data.date)}</time>
              </a>
            </li>
          ))}
        </ul>
        <div class="blog-more" data-reveal>
          <a href="/essays/">view all →</a>
        </div>
      </>
    )}
  </div>
</section>
