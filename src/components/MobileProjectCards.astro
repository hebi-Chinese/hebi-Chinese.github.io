---
import { projects, getProjectDisplayNumber } from '../data/site';
interface Props { headingLevel: 'h2' | 'h3' }
const { headingLevel: Heading } = Astro.props;
---
<div class="mobile-projects" data-mobile-projects>
  <div class="mobile-rail" data-mobile-rail aria-label="左右滑动浏览项目">
    {projects.map((project, index) => (
      <a class="mobile-card" href={project.href} target="_blank" rel="noopener noreferrer"
        draggable="false" data-mobile-card data-project-key={project.slug} data-project-title={project.title}
        data-project-number={getProjectDisplayNumber(index)} aria-label={`${project.title}（GitHub，新标签页）`}>
        <div class="mobile-number" aria-hidden="true">{getProjectDisplayNumber(index)}</div>
        <Heading class="mobile-title">{project.title}</Heading>
        <p>{project.brief}</p>
        <span class="mobile-destination">{project.linkText}</span>
      </a>
    ))}
  </div>
  <div class="mobile-controls" data-mobile-controls hidden>
    <button type="button" data-mobile-previous aria-label="上一个项目">←</button>
    <p role="status" aria-label="当前项目" aria-live="polite" data-mobile-status></p>
    <button type="button" data-mobile-next aria-label="下一个项目">→</button>
  </div>
  <p class="mobile-hint" data-mobile-hint hidden>左右循环滑动 · 轻点卡片打开项目</p>
</div>
<style>
.mobile-projects { display: none; }
@media (max-width: 760px) {
  .mobile-projects { display: block; }
  .mobile-projects .mobile-rail {
    display: flex; align-items: stretch; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    scrollbar-width: none; margin-inline: calc(-1 * clamp(1.5rem, 4vw, 3rem));
    padding: 12px 11vw 32px; scroll-padding-inline: 11vw;
  }
  .mobile-rail::-webkit-scrollbar { display: none; }
  .mobile-projects .mobile-card {
    flex: 0 0 78vw; min-width: 0; min-height: 268px;
    display: flex; flex-direction: column; gap: 12px;
    padding: 24px; scroll-snap-align: center; scroll-snap-stop: always;
    background: #fffdfa; border: 1px solid var(--surface-2); border-radius: 12px;
    box-shadow: 0 10px 20px #3223140d; color: var(--text-primary);
  }
  .mobile-card .mobile-number { font: 400 36px/1 var(--font-mono); color: var(--text-muted); }
  .mobile-card .mobile-title { font: 400 clamp(22px, 5.6vw, 26px)/1.3 var(--font-title); overflow-wrap: anywhere; }
  .mobile-card p { font: 400 16px/1.75 var(--font-body); color: var(--text-secondary); }
  .mobile-card .mobile-destination { margin-top: auto; padding-top: 20px; font-size: 14px; color: var(--accent); }
  .mobile-projects .mobile-controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mobile-controls button { width: 44px; height: 44px; flex-shrink: 0; background: transparent; border: 1px solid var(--surface-3); border-radius: 50%; font-size: 20px; color: var(--text-secondary); cursor: pointer; }
  .mobile-controls button:disabled { opacity: .35; cursor: default; }
  .mobile-controls p { font: 12px/1.6 var(--font-mono); color: var(--text-secondary); text-align: center; }
  .mobile-projects .mobile-hint { text-align: center; font-size: 12px; color: var(--text-muted); margin-top: 12px; }

  .mobile-projects .mobile-controls[hidden] { display: none; }
  .mobile-projects:not([data-ready]) .mobile-rail { display: grid; gap: 16px; margin: 0; padding: 0; overflow: visible; }
  .mobile-projects:not([data-ready]) .mobile-card { min-height: 0; }
}
</style>
<script>
  import { mountMobileProjects } from './mobile-project-cards';
  mountMobileProjects();
  document.addEventListener('astro:page-load', mountMobileProjects);
</script>
