---
import type { FloatObject } from './objects';
interface Props { object: FloatObject }
const { object: o } = Astro.props;
---
<div class="float-object" data-float-object={o.key} aria-hidden="true"
  style={`left:${o.x / 2048 * 100}%;top:${o.y / 1139 * 100}%;width:${o.w / 2048 * 100}%;height:${o.h / 1139 * 100}%`}>
  <span class="float-erase"></span>
  <span class="float-ground"></span>
  <span class="float-thread"></span>
  <div class:list={['float-face', o.key]}>
    {o.key === 'logo' && <svg viewBox="0 0 64 64" fill="currentColor"><path d="M4 4h27l13 13-8 8-10-10H15v20l-7 7-4-4zM60 60H33L20 47l8-8 10 10h11V29l7-7 4 4z" /></svg>}
    {o.key === 'avatars' && <><span class="avatar">我</span><span class="avatar her">她</span><small>对话</small></>}
    {o.key === 'send' && <svg viewBox="0 0 32 32" fill="none"><path d="M16 27V6m-8 8 8-8 8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>}
    {o.key === 'role' && <><svg viewBox="0 0 32 32" fill="none"><path d="M5 10h5l3-4h7l3 4h4v16H5z" stroke="currentColor" stroke-width="2" /><circle cx="16" cy="17" r="5" stroke="currentColor" stroke-width="2" /></svg><span>角色</span><span class="selected-role">吟游诗人</span><span>帝王</span><span>浪子</span></>}
    {o.key === 'archive' && <><svg viewBox="0 0 32 32" fill="none"><ellipse cx="16" cy="7" rx="10" ry="4" stroke="currentColor" stroke-width="2" /><path d="M6 7v18c0 5 20 5 20 0V7M6 15c0 5 20 5 20 0M6 23c0 5 20 5 20 0" stroke="currentColor" stroke-width="2" /></svg><span>声纹档案</span></>}
    {o.key === 'wave' && <svg viewBox="0 0 32 32" fill="none"><path d="M3 13v6m5-10v14m5-19v24m6-17v10m5-14v18m5-12v6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>}
    {o.key === 'start' && <><i></i><span>开始转写</span></>}
  </div>
  <span class="float-note">{o.label}</span>
</div>
