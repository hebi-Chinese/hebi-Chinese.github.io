---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import { getCollection } from 'astro:content';
import { formatContentDate, toContentDate } from '../../utils/content-date';
import '../../styles/global.css';

const essays = (await getCollection('essays', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="何必 / essays">
  <Nav />
  <main class="page-main">
    <div class="wrap">
      <div class="section-label" data-reveal>Essays</div>
      <h1 class="section-title page-title" data-reveal>长文</h1>

      {essays.length === 0 ? (
        <div class="content-empty" data-reveal>
          <p>
            还没有长文。<br/>写不动就不写。
          </p>
        </div>
      ) : (
        <ol class="content-list">
          {essays.map(essay => (
            <li>
              <a href={`/essays/${essay.id}`}>
                <time datetime={toContentDate(essay.data.date)}>
                  {formatContentDate(essay.data.date)}
                </time>
                <h2>{essay.data.title}</h2>
                {essay.data.description && <p>{essay.data.description}</p>}
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </main>
</BaseLayout>
