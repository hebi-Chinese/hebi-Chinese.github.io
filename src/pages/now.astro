---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';
---
<BaseLayout title="何必 / now">
  <Nav />
  <main class="page-main">
    <div class="wrap">
      <div class="section-label" data-reveal>Now</div>
      <h1 class="section-title page-title" data-reveal>当下</h1>
      <div class="page-copy" data-reveal>
        <p>主线：学习。副本：即将解锁。</p>
      </div>
    </div>
  </main>
</BaseLayout>
