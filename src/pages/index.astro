---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import HeroAboutFlow from '../components/HeroAboutFlow.astro';
import ProductShowcase from '../components/ProductShowcase/ProductShowcase.astro';
import ProjectsWheel from '../components/ProjectsWheel.astro';
import Blog from '../components/Blog.astro';
import Contact from '../components/Contact.astro';
import '../styles/global.css';
---
<BaseLayout>
  <Nav />
  <main>
    <HeroAboutFlow>
      <ProductShowcase slot="after-about" />
    </HeroAboutFlow>
    <ProjectsWheel immersive />
    <Blog />
    <Contact />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p>
        2025 – 2026 &copy; 何必 · built from scratch
      </p>
    </div>
  </footer>
</BaseLayout>
